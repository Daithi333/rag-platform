# Rag Platform Environment variables. Copy this file to .env and adjust values as needed

# Application Settings
DEBUG=true
ENVIRONMENT=development

# Postgres Database
POSTGRES_USER=rag_platform_user
POSTGRES_PASSWORD=rag_platform_password
POSTGRES__DATABASE_URL=postgresql+psycopg2://rag_platform_user:rag_platform_password@postgres:5432/rag_platform_db
POSTGRES__ECHO_SQL=false
POSTGRES__POOL_SIZE=20
POSTGRES__MAX_OVERFLOW=0

# Test Database
POSTGRES__TEST_DATABASE_URL=postgresql+psycopg2://rag_platform_user:rag_platform_password@postgres:5432/rag_platform_test_db

# Airflow Settings
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__CORE__LOAD_EXAMPLES=false
AIRFLOW__WEBSERVER__EXPOSE_CONFIG=true
AIRFLOW_POSTGRES_USER=airflow
AIRFLOW_POSTGRES_PASSWORD=airflow

# Dev.to Ingestion
DEVTO__API_KEY=your_devto_api_key_here
DEVTO__BASE_URL=https://dev.to/api
DEVTO__TAGS=["python", "webdev"]
DEVTO__PER_PAGE=30
DEVTO__RATE_LIMIT_DELAY=0.5
DEVTO__TIMEOUT_SECONDS=30
DEVTO__MAX_RETRIES=3

# OpenSearch
OPENSEARCH__HOST=http://opensearch:9200
OPENSEARCH__INDEX_NAME=devto-articles
OPENSEARCH__CHUNK_INDEX_SUFFIX=chunks
OPENSEARCH__VECTOR_DIMENSION=1024

# Jina AI Embeddings
JINA__API_KEY=your_jina_api_key_here

# Ollama LLM
OLLAMA__HOST=http://ollama:11434
OLLAMA__MODEL=llama3.2:3b
